// SPDX-License-Identifier: GPL-3.0-only
// PkgWithPartsShouldBeMerged - Windows resources (version info + manifest).
//
// The version numbers come from CMake so they can never drift from
// project(... VERSION ...). Generated from pkg_merge.rc.in.
//
// SPDX-License-Identifier: GPL-3.0-only. See LICENSE for the licence text.
#include <winver.h>

#define VER_FILEVERSION             @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
#define VER_FILEVERSION_STR         "@PROJECT_VERSION@\0"
#define VER_PRODUCTVERSION          VER_FILEVERSION
#define VER_PRODUCTVERSION_STR      VER_FILEVERSION_STR

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VER_FILEVERSION
 PRODUCTVERSION VER_PRODUCTVERSION
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "SpaceJamp\0"
            VALUE "FileDescription",  "Merge split PS4 PKG pieces back into a single PKG\0"
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     "pkg_merge\0"
            VALUE "LegalCopyright",   "@PKG_MERGE_COPYRIGHT@\0"
            VALUE "OriginalFilename", "pkg_merge.exe\0"
            VALUE "ProductName",      "PkgWithPartsShouldBeMerged\0"
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

1 RT_MANIFEST "@CMAKE_CURRENT_BINARY_DIR@/app.manifest"